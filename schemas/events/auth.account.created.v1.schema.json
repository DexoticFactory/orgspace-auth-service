{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orgspace.local/auth.account.created.v1.schema.json",
  "title": "auth.account.created.v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "const": "auth.account.created.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "orgspace-auth-service"
    },
    "correlationId": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "accountId",
        "status"
      ],
      "properties": {
        "accountId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending_activation",
            "active"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
